diff --git a/src/bar.c b/src/bar.c
index 88df424..87c6862 100644
--- a/src/bar.c
+++ b/src/bar.c
@@ -81,7 +81,13 @@ static void bar_calculate_popup_anchor_for_bar_item(struct bar* bar, struct bar_
 
 void bar_order_item_windows(struct bar* bar) {
   if (bar->sid < 1 || bar->adid < 1 || !bar->shown) return;
-  window_set_level(&bar->window, g_bar_manager.window_level);
+  // One level per layer — bar background < brackets < items. WindowServer
+  // raises a clicked window above others on the *same* level, so with all
+  // three sharing one, a click on empty bar space lifted the background over
+  // every item (a bracket's padding, the bracket over its items), dimming
+  // them until something re-ordered the stack. Distinct levels make that
+  // impossible, rather than repairing it after the click.
+  window_set_level(&bar->window, g_bar_manager.window_level - 2);
   window_order(&bar->window, NULL, W_ABOVE);
 
   struct window* previous_window = NULL;
@@ -91,7 +97,9 @@ void bar_order_item_windows(struct bar* bar) {
     if (bar_item->position == POSITION_POPUP) continue;
 
     struct window* window = bar_item_get_window(bar_item, bar->adid);
-    window_set_level(window, g_bar_manager.window_level);
+    window_set_level(window, bar_item->type == BAR_COMPONENT_GROUP
+                             ? g_bar_manager.window_level - 1
+                             : g_bar_manager.window_level     );
 
     if (!first_window) first_window = window;
 
